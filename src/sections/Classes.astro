---
const classes = [
  {
    name: 'Work Out',
    tag: 'Kháng lực',
    desc: 'Tập kháng lực toàn thân xây cơ, tăng sức mạnh và đốt mỡ ngay cả sau buổi tập.',
    duration: '60 phút',
    level: 'Mọi cấp',
    color: '#FDF201',
    icon: '🏋️',
  },
  {
    name: 'Kettle Bell',
    tag: 'Kháng lực',
    desc: 'Bài tập tạ kettlebell phát triển sức bền, sức nổ và toàn bộ nhóm cơ.',
    duration: '60 phút',
    level: 'Mọi cấp',
    color: '#EAB308',
    icon: '🤸',
  },
  {
    name: 'Step',
    tag: 'Cardio',
    desc: 'Bước lên bước xuống theo nhạc sôi động — đốt calorie cực mạnh, vui vẻ.',
    duration: '60 phút',
    level: 'Mọi cấp',
    color: '#EF4444',
    icon: '👟',
  },
  {
    name: 'Jumping',
    tag: 'Cardio',
    desc: 'Nhảy theo nhạc năng lượng cao, đốt mỡ toàn thân, giải phóng stress.',
    duration: '60 phút',
    level: 'Mọi cấp',
    color: '#A855F7',
    icon: '🤾',
  },
  {
    name: 'Tabata',
    tag: 'Cardio',
    desc: '20 giờ tập / 10 giây nghỉ — HIIT cường độ cao đốt mỡ tối đa trong thời gian ngắn.',
    duration: '60 phút',
    level: 'Mọi cấp',
    color: '#0EA5E9',
    icon: '🔥',
  },
];
---

<section id="lop-hoc" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Lớp học</div>
      <h2 class="mt-3 text-4xl font-display uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
        5 MÔN. ÂM NHẠC SÔI ĐỘNG.
        <span class="text-brand">NĂNG LƯỢNG KHÔNG NGỪNG.</span>
      </h2>
      <p class="mt-4 text-lg text-ink-2">
        Mỗi lớp được thiết kế để bạn ra mồ hôi, đốt mỡ và về nhà vui vẻ. HLV trẻ năng động chỉ dẫn từng động tác — bạn chỉ cần đến và làm theo.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        classes.map((c) => (
          <article
            class="group relative overflow-hidden rounded-3xl border border-white/10 bg-surface p-6 transition duration-300 hover:-translate-y-1.5 hover:border-white/20 hover:shadow-[0_20px_60px_-20px_rgba(0,0,0,.6)]"
            data-reveal
          >
            <div
              class="absolute -right-10 -top-10 h-32 w-32 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-60"
              style={`background:${c.color}`}
            ></div>

            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider" style={`background:${c.color}22; color:${c.color}`}>
                  {c.tag}
                </span>
                <span class="text-3xl" aria-hidden="true">{c.icon}</span>
              </div>

              <h3 class="mt-5 font-display text-2xl uppercase tracking-wide text-ink">{c.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{c.desc}</p>

              <div class="mt-5 flex items-center gap-4 border-t border-white/10 pt-4 text-xs text-ink-muted">
                <span class="flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  {c.duration}
                </span>
                <span class="flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 2 15 8h6l-5 4 2 7-6-4-6 4 2-7-5-4h6z" />
                  </svg>
                  {c.level}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
