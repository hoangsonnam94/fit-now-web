---
const trainers = [
  {
    name: 'HLV Chuc',
    role: 'HLV Trưởng · Work Out & Kettle Bell',
    bio: 'Chuyên kháng lực và xây cơ. Nhiệt huyết, theo sát từng động tác để đảm bảo hiệu quả và an toàn cho mọi học viên.',
    img: '/media/hlv-chuc.jpg',
    w: 900,
    h: 1350,
  },
  {
    name: 'HLV Tom',
    role: 'HLV Cardio · Step, Jumping & Tabata',
    bio: 'Năng lượng tràn đầy, lớp học sôi động theo nhạc. Biến mỗi buổi tập thành bữa tiệc đốt mỡ.',
    img: '/media/hlv-tom.jpg',
    w: 900,
    h: 1350,
  },
  {
    name: 'HLV Jennie',
    role: 'HLV Group X · Cardio & Dance',
    bio: 'Trẻ, năng động, truyền cảm hứng. Giữ nhịp lớp học luôn bùng cháy từ đầu đến cuối buổi.',
    img: '/media/hlv-jennie.jpg',
    w: 900,
    h: 1349,
  },
  {
    name: 'HLV MiA',
    role: 'HLV Group X · Nutrition Coach',
    bio: 'Tư vấn dinh dưỡng cá nhân hóa, hướng dẫn tính calories & macro, group coaching hằng ngày.',
    img: '/media/hlv-mia.jpg',
    w: 900,
    h: 1349,
  },
];
---

<section id="hlv" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div class="max-w-2xl">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Đội ngũ</div>
        <h2 class="mt-3 text-4xl font-display uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
          HLV TRẺ NĂNG ĐỘNG.
          <span class="text-brand">THEO SÁT TỪNG NGƯỜI.</span>
        </h2>
      </div>
      <p class="max-w-md text-ink-2">
        HLV không chỉ hướng dẫn — họ đồng hành và điều chỉnh bài tập theo từng học viên. Đảm bảo ai cũng có kết quả.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        trainers.map((t, i) => (
          <article
            class="group relative overflow-hidden rounded-3xl border border-white/10 bg-surface transition duration-300 hover:-translate-y-1.5 hover:border-white/20"
            data-reveal
            data-delay={String(Math.min(i, 3))}
          >
            <div class="relative aspect-[3/4] overflow-hidden">
              <img
                src={t.img}
                alt={t.name}
                width={t.w}
                height={t.h}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/30 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-5">
                <h3 class="font-display text-xl uppercase tracking-wide text-ink">{t.name}</h3>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand">{t.role}</p>
              </div>
            </div>
            <div class="p-5">
              <p class="text-sm leading-relaxed text-ink-2">{t.bio}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
