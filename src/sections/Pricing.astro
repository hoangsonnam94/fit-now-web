---
const plans = [
  {
    name: 'Gói Cơ Bản',
    price: '2.250K',
    period: '/ 30 buổi',
    validity: '(hiệu lực 50 ngày)',
    desc: 'Tập + F1 Herbalife + Chế độ ăn cá nhân + Group coaching.',
    features: [
      '30 buổi tập không giới hạn',
      'Trà NRG + bữa ăn F1 dinh dưỡng',
      'Chế độ ăn cá nhân hóa',
      'Group coaching hàng ngày',
      'Hướng dẫn chọn thực phẩm',
      'Tư vấn thể trạng miễn phí',
    ],
    cta: 'Chọn gói Cơ Bản',
    highlight: false,
  },
  {
    name: 'Gói Nâng Cao',
    price: '2.970K',
    period: '/ 30 buổi',
    validity: '(hiệu lực 75 ngày)',
    desc: 'Gói Cơ Bản + PPP. Tăng thêm đạm & sản phẩm hỗ trợ.',
    features: [
      'Mọi quyền lợi gói Cơ Bản',
      'Thêm PPP (Multi-Vitamin)',
      'Hỗ trợ dinh dưỡng cao cấp',
      'InBody check 2 lần',
      'Ưu tiên đặt lớp',
      'Tủ đồ & khăn miễn phí',
    ],
    cta: 'Chọn gói Nâng Cao',
    highlight: true,
  },
  {
    name: 'Gói Tối Ưu',
    price: '4.470K',
    period: '/ 30 buổi',
    validity: '(hiệu lực 90 ngày)',
    desc: 'Gói Nâng Cao + H24 Rebuild. Hỗ trợ toàn diện 24/7.',
    features: [
      'Mọi quyền lợi gói Nâng Cao',
      'H24 Rebuild (hỗ trợ toàn diện)',
      'Dinh dưỡng nâng cao nhất',
      'InBody check mỗi tuần',
      'Tư vấn 1-1 với nutrition coach',
      'Group coaching + support 24/7',
    ],
    cta: 'Chọn gói Tối Ưu',
    highlight: false,
  },
];

const promos = [
  { duration: '60 buổi', bonus: '+5 buổi', desc: 'Thêm 5 buổi miễn phí' },
  { duration: '90 buổi', bonus: '+12 buổi', desc: 'Thêm 12 buổi miễn phí' },
];
---

<section id="bang-gia" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="text-center" data-reveal>
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Bảng giá</div>
      <h2 class="mt-3 text-4xl font-display uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
        ĐẦU TƯ CHO<br/>
        <span class="text-brand">KẾT QUẢ GIẢM CÂN.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-2">
        3 gói đa dạng, tùy mục tiêu. Gói 60–90 buổi có thêm bonus buổi miễn phí. Không hợp đồng, hủy bất cứ lúc nào.
      </p>
    </div>

    <!-- Pricing cards -->
    <div class="mt-16 grid gap-6 lg:grid-cols-3 lg:items-stretch">
      {
        plans.map((p) => (
          <div
            class={`relative flex flex-col rounded-3xl border p-7 transition duration-300 ${
              p.highlight
                ? 'border-brand/60 bg-gradient-to-b from-brand/10 to-surface shadow-[0_0_60px_-15px_rgba(253,242,1,.35)] lg:-translate-y-3'
                : 'border-white/10 bg-surface hover:border-white/20'
            }`}
            data-reveal
          >
            {p.highlight && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-brand px-4 py-1 text-xs font-bold uppercase tracking-wider text-[#0A0A0A]">
                Phổ biến nhất
              </div>
            )}
            <h3 class="font-display text-2xl uppercase tracking-wide">{p.name}</h3>
            <p class="mt-2 text-sm text-ink-2">{p.desc}</p>
            <div class="mt-6 flex items-baseline gap-1">
              <span class="font-display text-5xl text-brand">{p.price}</span>
              <span class="text-sm text-ink-muted">{p.period}</span>
            </div>
            <div class="mt-1 text-xs text-ink-muted">{p.validity}</div>
            <ul class="mt-7 flex-1 space-y-3">
              {p.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-2">
                  <svg class="mt-0.5 shrink-0 text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="#lien-he"
              class={`mt-8 inline-flex items-center justify-center rounded-full px-6 py-3.5 text-sm font-bold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand ${
                p.highlight
                  ? 'bg-brand text-[#0A0A0A] hover:bg-brand-light hover:shadow-[0_0_28px_rgba(253,242,1,.5)]'
                  : 'border border-white/15 bg-white/5 text-ink hover:border-white/30 hover:bg-white/10'
              }`}
            >
              {p.cta}
            </a>
          </div>
        ))
      }
    </div>

    <!-- Promotions -->
    <div class="mt-14">
      <div class="rounded-3xl border border-brand/40 bg-gradient-to-r from-brand/15 to-transparent p-6 sm:p-8" data-reveal>
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Khuyến mãi</div>
        <h3 class="mt-2 font-display text-2xl uppercase tracking-wide text-ink">Gói 60 – 90 buổi có thêm buổi miễn phí</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            promos.map((pr) => (
              <div class="flex items-center gap-4 rounded-2xl bg-white/5 p-4">
                <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand text-[#0A0A0A] font-display font-bold text-lg">
                  {pr.bonus}
                </div>
                <div>
                  <div class="text-sm font-bold text-ink">{pr.duration}</div>
                  <div class="text-xs text-ink-muted">{pr.desc}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
