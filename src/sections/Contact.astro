---
// Nơi nhận lead: paste URL Google Apps Script (ghi vào Google Sheets)
// hoặc https://formsubmit.co/EMAIL_CUA_BAN (gửi email) vào đây.
// Nếu để trống (""), form sẽ chỉ mô phỏng và hiện trạng thái thành công.
const leadEndpoint = '';
const hotlineDisplay = '0901 234 567';
const hotline = 'tel:+84901234567';
const zalo = 'https://zalo.me/84901234567';
const address = 'Phòng Group X FIT NOW — Ocean Park 1';
---

<section id="lien-he" class="relative py-24 sm:py-32">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-bg via-bg-soft to-bg"></div>
    <div class="absolute bottom-0 left-1/2 h-[400px] w-[700px] -translate-x-1/2 rounded-full bg-brand/10 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Liên hệ</div>
        <h2 class="mt-3 text-4xl font-display uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
          3 BUỔI THỬ
          <span class="text-brand">MIỄN PHÍ.</span>
        </h2>
        <p class="mt-4 max-w-lg text-lg text-ink-2">
          Điền form hoặc gọi ngay để đặt lịch 3 buổi tập thử miễn phí. Chúng tôi sẽ gọi/Zalo lại trong 15 phút — không spam, không ràng buộc.
        </p>

        <div class="mt-8 space-y-4">
          <a href={hotline} class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 transition duration-200 hover:border-brand/40 hover:bg-brand/5">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand/15 text-brand">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-muted">Hotline</div>
              <div class="font-bold text-ink group-hover:text-brand">{hotlineDisplay}</div>
            </div>
          </a>

          <a href={zalo} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 transition duration-200 hover:border-accent/40 hover:bg-accent/5">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-accent/15 text-accent">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              </svg>
            </span>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-muted">Zalo</div>
              <div class="font-bold text-ink group-hover:text-accent">Nhắn Zalo ngay</div>
            </div>
          </a>

          <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-ink-2">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-muted">Địa chỉ</div>
              <div class="font-bold text-ink">{address}</div>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal>
        <form
          id="contact-form"
          class="rounded-3xl border border-white/10 bg-surface p-7 sm:p-9"
          novalidate
        >
          <h3 class="font-display text-2xl uppercase tracking-wide">Đặt 3 buổi thử miễn phí</h3>
          <p class="mt-2 text-sm text-ink-muted">Điền thông tin, chúng tôi gọi/Zalo lại trong 15 phút.</p>

          <div class="mt-7 space-y-5">
            <div>
              <label for="f-name" class="mb-1.5 block text-sm font-semibold text-ink">Họ và tên <span class="text-brand">*</span></label>
              <input
                id="f-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Nguyễn Văn A"
                class="w-full rounded-xl border border-white/10 bg-bg px-4 py-3.5 text-base text-ink placeholder:text-ink-muted/60 transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              />
              <p class="mt-1.5 hidden text-sm text-red-400" data-error="f-name">Vui lòng nhập họ tên.</p>
            </div>

            <div>
              <label for="f-phone" class="mb-1.5 block text-sm font-semibold text-ink">Số điện thoại <span class="text-brand">*</span></label>
              <input
                id="f-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                inputmode="tel"
                placeholder="0901 234 567"
                class="w-full rounded-xl border border-white/10 bg-bg px-4 py-3.5 text-base text-ink placeholder:text-ink-muted/60 transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              />
              <p class="mt-1.5 hidden text-sm text-red-400" data-error="f-phone">Vui lòng nhập số điện thoại hợp lệ.</p>
            </div>

            <div>
              <label for="f-package" class="mb-1.5 block text-sm font-semibold text-ink">Gói bạn quan tâm</label>
              <select
                id="f-package"
                name="package"
                class="w-full appearance-none rounded-xl border border-white/10 bg-bg px-4 py-3.5 text-base text-ink transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              >
                <option value="">Chưa chọn — tư vấn giúp tôi</option>
                <option>Gói Cơ Bản (2.250K / 30 buổi)</option>
                <option>Gói Nâng Cao (2.970K / 30 buổi)</option>
                <option>Gói Tối Ưu (4.470K / 30 buổi)</option>
              </select>
            </div>

            <div>
              <label for="f-note" class="mb-1.5 block text-sm font-semibold text-ink">Ghi chú (không bắt buộc)</label>
              <textarea
                id="f-note"
                name="note"
                rows="3"
                placeholder="Mục tiêu giảm cân? Ca tập nào tiện?"
                class="w-full resize-none rounded-xl border border-white/10 bg-bg px-4 py-3.5 text-base text-ink placeholder:text-ink-muted/60 transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              ></textarea>
            </div>

            <button
              type="submit"
              class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand px-7 py-4 text-base font-bold text-[#0A0A0A] shadow-[0_10px_40px_-10px_rgba(253,242,1,.6)] transition duration-300 hover:-translate-y-0.5 hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
            >
              Gửi — nhận cuộc gọi trong 15 phút
              <svg class="transition-transform duration-300 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </button>

            <p class="text-center text-xs text-ink-muted">
              Bằng việc gửi form, bạn đồng ý cho FIT NOW liên hệ qua điện thoại/Zalo.
            </p>
          </div>

          <!-- success state -->
          <div id="form-success" class="hidden text-center">
            <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-accent/20 text-accent">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </div>
            <h3 class="mt-5 font-display text-2xl uppercase tracking-wide text-accent">Đã gửi thành công!</h3>
            <p class="mt-2 text-ink-2">
              Cảm ơn bạn! Chúng tôi sẽ gọi/Zalo lại trong 15 phút để xác nhận lịch tập thử.
              <br />Gấp lắm? Gọi ngay
              <a href={hotline} class="font-bold text-brand underline-offset-4 hover:underline">{hotlineDisplay}</a>.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success')!;
  const leadEndpoint = form.dataset.endpoint ?? '';

  const show = (id: string, on: boolean) => {
    const el = document.querySelector(`[data-error="${id}"]`);
    el?.classList.toggle('hidden', !on);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = form.querySelector<HTMLInputElement>('#f-name')!;
    const phone = form.querySelector<HTMLInputElement>('#f-phone')!;

    const nameOk = name.value.trim().length >= 2;
    const phoneOk = /^[0-9+\s().-]{8,15}$/.test(phone.value.trim());
    show('f-name', !nameOk);
    show('f-phone', !phoneOk);
    if (!nameOk) { name.focus(); return; }
    if (!phoneOk) { phone.focus(); return; }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    btn.textContent = 'Đang gửi...';

    try {
      if (leadEndpoint) {
        const data = Object.fromEntries(new FormData(form).entries());
        await fetch(leadEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ ...data, source: 'Landing FIT NOW Ocean Park 1', time: new Date().toISOString() }),
        });
      }
      form.querySelector('.mt-7')?.classList.add('hidden');
      success.classList.remove('hidden');
    } catch {
      btn.disabled = false;
      btn.textContent = 'Gửi — nhận cuộc gọi trong 15 phút';
      alert('Có lỗi khi gửi. Vui lòng gọi/Zalo trực tiếp cho chúng tôi.');
    }
  });
</script>
