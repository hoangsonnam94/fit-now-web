---
const dims = [
  [1526, 2035],
  [1600, 2133],
  [1600, 2133],
  [1600, 2133],
  [1600, 1200],
  [1600, 2133],
  [1600, 2133],
  [1526, 2035],
  [1600, 1600],
  [1600, 1600],
  [1600, 1600],
];
const photos = dims.map(([w, h], i) => ({
  src: `/media/afterclass-${String(i + 1).padStart(2, '0')}.jpg`,
  w,
  h,
}));
---

<section id="khoanh-khac" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div class="max-w-2xl">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">Khoảnh khắc</div>
        <h2 class="mt-3 text-4xl font-display uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
          SAU MỖI CA TẬP.
          <span class="text-brand">MỘT CỘNG ĐỒNG.</span>
        </h2>
      </div>
      <p class="max-w-md text-ink-2">
        Những bức ảnh được chụp sau khi kết thúc ca tập — ai cũng mệt, ai cũng cười, và ai cũng thấy mình mạnh hơn.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        photos.map((p, i) => (
          <figure
            class={`group relative overflow-hidden rounded-2xl border border-white/10 bg-surface ${i === 0 ? 'col-span-2 row-span-2 sm:col-span-2 lg:col-span-2' : ''}`}
            data-reveal
            data-delay={String(Math.min(i % 4, 3))}
          >
            <img
              src={p.src}
              alt={`Khoảnh khắc sau ca tập ${i + 1}`}
              width={p.w}
              height={p.h}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full object-cover object-center transition duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
